{
  "name": "programuesi-i-veturave",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Website for Programuesi i Veturave — professional car coding and feature activation in Prishtinë, Tiranë and Durrës.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "assets": "node scripts/generate-assets.mjs",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "homepage": "https://programuesiiveturave.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iligashi/Programusi-i-Veturave-.git"
  },
  "bugs": {
    "url": "https://github.com/iligashi/Programusi-i-Veturave-/issues"
  },
  "author": "Ilaz Gashi (https://github.com/iligashi)",
  "license": "UNLICENSED",
  "keywords": [
    "car-coding",
    "react",
    "vite",
    "typescript",
    "tailwindcss",
    "framer-motion",
    "i18n"
  ],
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
